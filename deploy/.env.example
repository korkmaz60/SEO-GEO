# Settings for deploy/compose.yaml. `./deploy/init.sh` copies this file to deploy/.env and
# fills in the secrets. Keep deploy/.env private and backed up: ENCRYPTION_KEY is needed to
# read stored provider keys.

# The address people open in the browser, without a trailing slash.
WEB_URL=http://localhost:3000
# Where the web app is published on this machine. Use 127.0.0.1 behind Caddy or another proxy.
WEB_BIND=0.0.0.0
WEB_PORT=3000

# HTTPS with the bundled Caddy (`--profile https`): your domain, pointing at this server.
# Also set WEB_URL=https://<DOMAIN> and WEB_BIND=127.0.0.1.
DOMAIN=

# Database
POSTGRES_DB=seogeo
POSTGRES_USER=seogeo
POSTGRES_PASSWORD=

# Secrets (openssl rand -base64 32)
AUTH_SECRET=
ENCRYPTION_KEY=

# Email for verification, password resets and invitations. Without it, sign-up needs no
# verification and invitation links are copied from the members page instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SEO-GEO <noreply@example.com>

# Google Search Console and GA4 (optional): an OAuth client of type "Web application" with
# the redirect URI <WEB_URL>/api/v1/integrations/google/callback. See docs/self-hosting.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ports the crawler may request on audited sites (internal addresses are always refused).
OUTBOUND_ALLOWED_PORTS=80,443

# Interactive API docs at /api/docs.
API_DOCS=false
LOG_LEVEL=log
