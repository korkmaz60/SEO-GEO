{
  "name": "@seo-geo/billing",
  "version": "0.0.0",
  "private": true,
  "description": "Cloud edition billing: plan catalog, provider interface and the Stripe (Managed Payments) adapter",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@seo-geo/contracts": "workspace:*",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
