// SEO-GEO database schema. Conventions (docs/data-model.md):
// - tables and columns are snake_case in PostgreSQL, camelCase in Prisma;
// - primary keys are UUIDs (v7 when generated by the application);
// - timestamps are timestamptz;
// - every tenant-owned row carries workspace_id, and queries always filter by it.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ── Identity (managed by Better Auth; field names must match its schema) ──────────

model User {
  id               String   @id @default(uuid(7)) @db.Uuid
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  locale           String?
  twoFactorEnabled Boolean? @default(false) @map("two_factor_enabled")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      Session[]
  accounts      Account[]
  memberships   Member[]
  invitations   Invitation[]
  twoFactors    TwoFactor[]
  notifications Notification[]

  @@map("user")
}

model Session {
  id                   String   @id @default(uuid(7)) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  token                String   @unique
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  /// Password hash for email + password accounts.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

/// Email verification and password reset tokens.
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

/// Shown in the product as a workspace.
model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  members             Member[]
  invitations         Invitation[]
  projects            Project[]
  brandEntities       BrandEntity[]
  providerCredentials ProviderCredential[]
  usageEntries        UsageEntry[]
  budget              Budget?
  tasks               Task[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  trackedKeywords     TrackedKeyword[]
  rankChecks          RankCheck[]
  keywordLists        KeywordList[]
  googleConnections   GoogleConnection[]
  googleOAuthClient   GoogleOAuthClient?
  projectIntegrations ProjectIntegration[]
  auditRuns           AuditRun[]
  prompts             Prompt[]
  aiRuns              AiRun[]
  apiKeys             WorkspaceApiKey[]

  @@map("organization")
}

/// Workspace membership. Roles: owner, admin, member, viewer.
model Member {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String   @default("member")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  inviterId      String   @map("inviter_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

/// Public API and MCP keys. `referenceId` is the owning user.
model Apikey {
  id                  String    @id @default(uuid(7)) @db.Uuid
  configId            String    @default("default") @map("config_id")
  name                String?
  start               String?
  referenceId         String    @map("reference_id") @db.Uuid
  prefix              String?
  /// Hash of the key; the key itself is shown once.
  key                 String
  refillInterval      Int?      @map("refill_interval")
  refillAmount        Int?      @map("refill_amount")
  lastRefillAt        DateTime? @map("last_refill_at") @db.Timestamptz(3)
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true) @map("rate_limit_enabled")
  /// Per-key rate limit: 600 requests a minute (see auth.ts).
  rateLimitTimeWindow Int?      @default(60000) @map("rate_limit_time_window")
  rateLimitMax        Int?      @default(600) @map("rate_limit_max")
  requestCount        Int?      @default(0) @map("request_count")
  remaining           Int?
  lastRequest         DateTime? @map("last_request") @db.Timestamptz(3)
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  permissions         String?
  metadata            String?

  workspaceKey WorkspaceApiKey?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

// ── Projects ───────────────────────────────────────────────────────────────────

enum Device {
  DESKTOP
  MOBILE

  @@map("device")
}

model Project {
  id                  String    @id @default(uuid(7)) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  name                String
  slug                String
  /// Normalized hostname without `www.`, e.g. `example.com`.
  domain              String
  includeSubdomains   Boolean   @default(true) @map("include_subdomains")
  /// DataForSEO location code, e.g. 2792 for Turkey.
  defaultLocationCode Int       @map("default_location_code")
  defaultLanguageCode String    @map("default_language_code")
  defaultDevice       Device    @default(DESKTOP) @map("default_device")
  timezone            String    @default("UTC")
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace       Organization         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandEntities   BrandEntity[]
  usageEntries    UsageEntry[]
  tasks           Task[]
  trackedKeywords TrackedKeyword[]
  rankChecks      RankCheck[]
  integrations    ProjectIntegration[]
  gscSiteDaily    GscSiteDaily[]
  gscQueryDaily   GscQueryDaily[]
  gscPageDaily    GscPageDaily[]
  ga4PageDaily    Ga4PageDaily[]
  auditRuns       AuditRun[]
  prompts         Prompt[]
  aiSettings      ProjectAiSettings?
  aiRuns          AiRun[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, createdAt])
  @@map("project")
}

enum BrandKind {
  OWN
  COMPETITOR

  @@map("brand_kind")
}

/// The project's own brand and its competitors; one OWN entity per project (enforced by the service).
model BrandEntity {
  id               String    @id @default(uuid(7)) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  kind             BrandKind
  name             String
  /// Registrable domains that count as this brand.
  domains          String[]
  /// Other names the brand is mentioned by, e.g. product names.
  aliases          String[]
  /// Names that are also ordinary words (e.g. "Mango"); they count as a mention only when
  /// the same answer also names one of the brand's domains or unambiguous names.
  ambiguousAliases String[]  @default([]) @map("ambiguous_aliases")
  /// Categorical chart slot (1–8); the own brand is always 1.
  colorSlot        Int       @map("color_slot")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aiMentions  AiMention[]
  aiCitations AiCitation[]

  @@index([workspaceId, projectId])
  @@map("brand_entity")
}

/// A workspace-bound API key: the key (in `apikey`) acts as its creator, only in this
/// workspace and only with these scopes (`read`, `write`, `run:paid`).
model WorkspaceApiKey {
  keyId       String   @id @map("key_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  scopes      String[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  key       Apikey       @relation(fields: [keyId], references: [id], onDelete: Cascade)
  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("workspace_api_key")
}

// ── Workspace-level entities ───────────────────────────────────────────────────────

enum Provider {
  DATAFORSEO
  OPENAI
  ANTHROPIC
  GOOGLE_AI
  OPENROUTER
  PERPLEXITY

  @@map("provider")
}

enum CredentialStatus {
  UNVERIFIED
  VALID
  INVALID

  @@map("credential_status")
}

/// A workspace's own provider key. The secret is AES-256-GCM encrypted and never returned.
model ProviderCredential {
  id              String           @id @default(uuid(7)) @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  provider        Provider
  label           String
  encryptedSecret Bytes            @map("encrypted_secret")
  keyVersion      Int              @map("key_version")
  status          CredentialStatus @default(UNVERIFIED)
  /// Non-secret details from the last verification, e.g. the DataForSEO login and balance.
  details         Json             @default("{}")
  lastError       String?          @map("last_error")
  lastVerifiedAt  DateTime?        @map("last_verified_at") @db.Timestamptz(3)
  createdBy       String?          @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@map("provider_credential")
}

enum BilledTo {
  /// Paid with the workspace's own provider key.
  WORKSPACE
  /// Paid with platform keys (cloud edition), charged as credits.
  PLATFORM

  @@map("billed_to")
}

/// Append-only ledger of provider costs.
model UsageEntry {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  taskId      String?  @map("task_id") @db.Uuid
  provider    Provider
  operation   String
  units       Int      @default(1)
  costUsd     Decimal  @map("cost_usd") @db.Decimal(12, 6)
  billedTo    BilledTo @default(WORKSPACE) @map("billed_to")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("usage_entry")
}

/// Monthly spending limit across providers. Checked before paid work is queued.
model Budget {
  workspaceId     String   @id @map("workspace_id") @db.Uuid
  monthlyLimitUsd Decimal  @map("monthly_limit_usd") @db.Decimal(12, 2)
  /// Block paid work once the limit is reached; otherwise only notify.
  hardStop        Boolean  @default(true) @map("hard_stop")
  /// Percentages of the limit that trigger a notification.
  alertThresholds Int[]    @default([50, 80, 100]) @map("alert_thresholds")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("budget")
}

enum TaskStatus {
  queued
  running
  succeeded
  failed
  canceled

  @@map("task_status")
}

/// A user-visible background operation.
model Task {
  id               String     @id @default(uuid(7)) @db.Uuid
  workspaceId      String     @map("workspace_id") @db.Uuid
  projectId        String?    @map("project_id") @db.Uuid
  type             String
  status           TaskStatus @default(queued)
  /// 0–100.
  progress         Int        @default(0)
  input            Json       @default("{}")
  result           Json?
  error            Json?
  estimatedCostUsd Decimal?   @map("estimated_cost_usd") @db.Decimal(12, 6)
  actualCostUsd    Decimal    @default(0) @map("actual_cost_usd") @db.Decimal(12, 6)
  idempotencyKey   String?    @map("idempotency_key")
  createdBy        String?    @map("created_by") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt        DateTime?  @map("started_at") @db.Timestamptz(3)
  finishedAt       DateTime?  @map("finished_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  usageEntries UsageEntry[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, createdAt])
  @@map("task")
}

/// Security-relevant actions.
model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorApiKeyId String?  @map("actor_api_key_id") @db.Uuid
  action        String
  targetType    String?  @map("target_type")
  targetId      String?  @map("target_id")
  metadata      Json     @default("{}")
  ip            String?
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("audit_log")
}

model Notification {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        String
  /// English fallback; clients render localized text from `type` and `data`.
  title       String
  body        String?
  /// Values for the localized message, e.g. `{ "percent": 80 }`.
  data        Json      @default("{}")
  link        String?
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([workspaceId, createdAt])
  @@map("notification")
}

// ── Provider cache ──────────────────────────────────────────────────────────────────

/// Provider responses keyed by operation and normalized parameters. Shared market data only
/// (keyword research, SERPs); tenant-private data such as Search Console is never cached here.
model ProviderCache {
  /// SHA-256 of the operation and its normalized parameters.
  key       String   @id
  provider  Provider
  /// Versioned operation name, e.g. `labs.keyword_suggestions@1`.
  operation String
  params    Json
  /// The normalized result, as returned by the service that cached it.
  response  Json
  /// What the provider charged for the original request.
  costUsd   Decimal  @map("cost_usd") @db.Decimal(12, 6)
  fetchedAt DateTime @map("fetched_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("provider_cache")
}

// ── Keywords and rank tracking ──────────────────────────────────────────────────────

enum SearchEngine {
  GOOGLE

  @@map("search_engine")
}

enum RankFrequency {
  DAILY
  WEEKLY

  @@map("rank_frequency")
}

/// Keyword metrics per market (shared market data), refreshed when older than 30 days.
/// A row with empty metrics records that the provider has no data for the keyword.
model KeywordMetric {
  /// Normalized: trimmed, single spaces, lower case.
  keyword           String
  locationCode      Int      @map("location_code")
  languageCode      String   @map("language_code")
  searchVolume      Int?     @map("search_volume")
  /// Average cost per click in USD.
  cpc               Float?
  /// Paid competition, 0–1.
  competition       Float?
  competitionLevel  String?  @map("competition_level")
  /// 0–100.
  keywordDifficulty Int?     @map("keyword_difficulty")
  intent            String?
  secondaryIntents  String[] @default([]) @map("secondary_intents")
  /// `[{ year, month, searchVolume }]`, oldest first.
  monthlySearches   Json     @default("[]") @map("monthly_searches")
  source            String   @default("dataforseo_labs")
  fetchedAt         DateTime @map("fetched_at") @db.Timestamptz(3)

  @@id([keyword, locationCode, languageCode])
  @@map("keyword_metric")
}

/// A keyword whose Google position the project checks on a schedule.
model TrackedKeyword {
  id           String        @id @default(uuid(7)) @db.Uuid
  workspaceId  String        @map("workspace_id") @db.Uuid
  projectId    String        @map("project_id") @db.Uuid
  /// Normalized: trimmed, single spaces, lower case.
  keyword      String
  locationCode Int           @map("location_code")
  languageCode String        @map("language_code")
  device       Device
  searchEngine SearchEngine  @default(GOOGLE) @map("search_engine")
  tags         String[]      @default([])
  /// The page that should rank; another URL ranking instead is flagged.
  targetUrl    String?       @map("target_url")
  frequency    RankFrequency @default(DAILY)
  createdBy    String?       @map("created_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checks    RankCheck[]

  @@unique([projectId, keyword, locationCode, languageCode, device, searchEngine])
  @@index([workspaceId, projectId])
  @@map("tracked_keyword")
}

enum RankCheckStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("rank_check_status")
}

/// One SERP check of a tracked keyword per day. Created as PENDING when the SERP is
/// requested and completed when the result is collected.
model RankCheck {
  id                String          @id @default(uuid(7)) @db.Uuid
  workspaceId       String          @map("workspace_id") @db.Uuid
  projectId         String          @map("project_id") @db.Uuid
  trackedKeywordId  String          @map("tracked_keyword_id") @db.Uuid
  /// Day of the check in the project's time zone.
  checkedOn         DateTime        @map("checked_on") @db.Date
  status            RankCheckStatus @default(PENDING)
  /// DataForSEO task ID while the SERP is being collected.
  providerTaskId    String?         @map("provider_task_id")
  postedAt          DateTime?       @map("posted_at") @db.Timestamptz(3)
  /// When the SERP was fetched.
  checkedAt         DateTime?       @map("checked_at") @db.Timestamptz(3)
  /// Number of results checked; no position means "not in the top `depth`".
  depth             Int
  /// Best organic position (rank_group) of the project's own domains.
  position          Int?
  rankAbsolute      Int?            @map("rank_absolute")
  url               String?
  serpFeatures      String[]        @default([]) @map("serp_features")
  /// SERP features that link to the project's own domains, e.g. `featured_snippet`.
  ownedFeatures     String[]        @default([]) @map("owned_features")
  aiOverviewPresent Boolean         @default(false) @map("ai_overview_present")
  aiOverviewCited   Boolean         @default(false) @map("ai_overview_cited")
  /// Best positions of competitors: `{ [brandEntityId]: { position, url } }`.
  competitorRanks   Json            @default("{}") @map("competitor_ranks")
  serpSnapshotId    String?         @map("serp_snapshot_id") @db.Uuid
  /// Provider cost of this check; 0 when an existing snapshot was reused.
  costUsd           Decimal         @default(0) @map("cost_usd") @db.Decimal(12, 6)
  error             String?
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace      Organization   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trackedKeyword TrackedKeyword @relation(fields: [trackedKeywordId], references: [id], onDelete: Cascade)
  serpSnapshot   SerpSnapshot?  @relation(fields: [serpSnapshotId], references: [id], onDelete: SetNull)

  @@unique([trackedKeywordId, checkedOn])
  @@index([projectId, checkedOn])
  @@index([status, postedAt])
  @@index([providerTaskId])
  @@map("rank_check")
}

/// A compact copy of a SERP (shared market data). Checks of the same query on the same day
/// reuse it; kept for 90 days.
model SerpSnapshot {
  id           String       @id @default(uuid(7)) @db.Uuid
  searchEngine SearchEngine @default(GOOGLE) @map("search_engine")
  keyword      String
  locationCode Int          @map("location_code")
  languageCode String       @map("language_code")
  device       Device
  /// UTC day of the fetch.
  fetchedOn    DateTime     @map("fetched_on") @db.Date
  fetchedAt    DateTime     @map("fetched_at") @db.Timestamptz(3)
  depth        Int
  itemTypes    String[]     @map("item_types")
  resultsCount BigInt?      @map("results_count")
  /// `[{ position, rankAbsolute, domain, url, title }]`
  organic      Json
  /// `[{ type, rankAbsolute, links: [{ domain, url }] }]`
  features     Json
  /// `{ rankAbsolute, references: [{ domain, url, title, source }] }`
  aiOverview   Json?        @map("ai_overview")
  checkUrl     String?      @map("check_url")

  rankChecks RankCheck[]

  @@unique([searchEngine, keyword, locationCode, languageCode, device, fetchedOn])
  @@index([fetchedAt])
  @@map("serp_snapshot")
}

/// Saved keyword research.
model KeywordList {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Organization      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     KeywordListItem[]

  @@index([workspaceId, createdAt])
  @@map("keyword_list")
}

model KeywordListItem {
  listId       String   @map("list_id") @db.Uuid
  keyword      String
  locationCode Int      @map("location_code")
  languageCode String   @map("language_code")
  note         String?
  addedAt      DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  list KeywordList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([listId, keyword, locationCode, languageCode])
  @@map("keyword_list_item")
}

// ── Google Search Console and Analytics ─────────────────────────────────────────────

enum GoogleConnectionStatus {
  ACTIVE
  /// Google refused the refresh token (access revoked or expired); reconnect needed.
  REVOKED

  @@map("google_connection_status")
}

/// A Google account connected for Search Console and Analytics. Tokens are AES-256-GCM
/// encrypted and never returned by the API.
/// A workspace's own Google OAuth client. Without one, the installation's client
/// (GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET) is used.
model GoogleOAuthClient {
  workspaceId     String   @id @map("workspace_id") @db.Uuid
  /// Not secret: Google shows it in every consent URL.
  clientId        String   @map("client_id")
  /// Encrypted client secret.
  encryptedSecret Bytes    @map("encrypted_secret")
  keyVersion      Int      @map("key_version")
  verifiedAt      DateTime @map("verified_at") @db.Timestamptz(3)
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("google_oauth_client")
}

model GoogleConnection {
  id              String                 @id @default(uuid(7)) @db.Uuid
  workspaceId     String                 @map("workspace_id") @db.Uuid
  /// Google account ID (`sub`).
  googleUserId    String                 @map("google_user_id")
  email           String
  scopes          String[]
  /// Encrypted JSON: `{ refreshToken, accessToken, expiresAt }`.
  encryptedTokens Bytes                  @map("encrypted_tokens")
  keyVersion      Int                    @map("key_version")
  status          GoogleConnectionStatus @default(ACTIVE)
  lastError       String?                @map("last_error")
  /// The OAuth client that issued the tokens; they only refresh with that client. `null` for
  /// connections made before workspaces could bring their own client (the installation's).
  oauthClientId   String?                @map("oauth_client_id")
  connectedBy     String?                @map("connected_by") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Organization         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integrations ProjectIntegration[]

  @@unique([workspaceId, googleUserId])
  @@map("google_connection")
}

enum IntegrationType {
  GSC
  GA4

  @@map("integration_type")
}

/// The Search Console property or GA4 property a project reads from.
model ProjectIntegration {
  id            String          @id @default(uuid(7)) @db.Uuid
  workspaceId   String          @map("workspace_id") @db.Uuid
  projectId     String          @map("project_id") @db.Uuid
  type          IntegrationType
  connectionId  String          @map("connection_id") @db.Uuid
  /// Search Console site (`sc-domain:example.com`, `https://www.example.com/`) or GA4
  /// property (`properties/123456`).
  externalId    String          @map("external_id")
  displayName   String?         @map("display_name")
  settings      Json            @default("{}")
  lastSyncedAt  DateTime?       @map("last_synced_at") @db.Timestamptz(3)
  /// Last day whose data has been imported.
  syncedThrough DateTime?       @map("synced_through") @db.Date
  lastError     String?         @map("last_error")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace  Organization     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connection GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
  @@index([connectionId])
  @@map("project_integration")
}

/// Search Console totals by day, including queries Google does not report individually.
model GscSiteDaily {
  projectId   String   @map("project_id") @db.Uuid
  date        DateTime @db.Date
  clicks      Int
  impressions Int
  /// Average position, weighted by impressions.
  position    Float

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, date])
  @@map("gsc_site_daily")
}

/// Search Console performance by query and day.
model GscQueryDaily {
  projectId   String   @map("project_id") @db.Uuid
  date        DateTime @db.Date
  query       String
  clicks      Int
  impressions Int
  /// Average position, weighted by impressions.
  position    Float

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, date, query])
  @@map("gsc_query_daily")
}

/// Search Console performance by page and day.
model GscPageDaily {
  projectId   String   @map("project_id") @db.Uuid
  date        DateTime @db.Date
  page        String
  clicks      Int
  impressions Int
  position    Float

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, date, page])
  @@map("gsc_page_daily")
}

/// GA4 sessions by landing page, channel group and source per day.
model Ga4PageDaily {
  projectId       String   @map("project_id") @db.Uuid
  date            DateTime @db.Date
  /// Landing page path, e.g. `/blog/post`.
  page            String
  /// Default channel group, e.g. `Organic Search`, `Referral`.
  channel         String
  /// Session source, e.g. `google`, `chatgpt.com`.
  source          String
  sessions        Int
  users           Int
  engagedSessions Int      @map("engaged_sessions")
  keyEvents       Float    @default(0) @map("key_events")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, date, page, channel, source])
  @@map("ga4_page_daily")
}

// ── Site audit ──────────────────────────────────────────────────────────────────────

enum AuditRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED

  @@map("audit_run_status")
}

enum IssueSeverity {
  ERROR
  WARNING
  NOTICE

  @@map("issue_severity")
}

/// One crawl of a project's site.
model AuditRun {
  id              String         @id @default(uuid(7)) @db.Uuid
  workspaceId     String         @map("workspace_id") @db.Uuid
  projectId       String         @map("project_id") @db.Uuid
  status          AuditRunStatus @default(QUEUED)
  /// `manual` or `schedule`.
  trigger         String         @default("manual")
  /// `{ startUrl, maxPages, maxDepth }`
  config          Json
  /// Counts by status class, severity and crawl outcome; see the audit service.
  stats           Json           @default("{}")
  pagesCrawled    Int            @default(0) @map("pages_crawled")
  healthScore     Int?           @map("health_score")
  scoreVersion    Int            @default(1) @map("score_version")
  /// Mean citability score of the indexable pages (0–100); `null` before M3 or without pages.
  citabilityScore Int?           @map("citability_score")
  taskId          String?        @map("task_id") @db.Uuid
  error           String?
  createdBy       String?        @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt       DateTime?      @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?      @map("finished_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages     AuditPage[]
  links     AuditLink[]
  issues    AuditIssue[]

  @@index([projectId, createdAt])
  @@map("audit_run")
}

/// A crawled URL.
model AuditPage {
  id              String   @id @default(uuid(7)) @db.Uuid
  runId           String   @map("run_id") @db.Uuid
  /// Normalized URL.
  url             String
  depth           Int
  /// HTTP status; null when the request failed (see `fetchError`).
  statusCode      Int?     @map("status_code")
  /// `timeout`, `network`, `too_large`, `blocked_by_robots`, …
  fetchError      String?  @map("fetch_error")
  contentType     String?  @map("content_type")
  redirectTarget  String?  @map("redirect_target")
  title           String?
  metaDescription String?  @map("meta_description")
  h1              String?
  h1Count         Int      @default(0) @map("h1_count")
  canonical       String?
  robotsMeta      String?  @map("robots_meta")
  indexable       Boolean  @default(false)
  wordCount       Int?     @map("word_count")
  contentHash     String?  @map("content_hash")
  loadMs          Int?     @map("load_ms")
  bytes           Int?
  inlinks         Int      @default(0)
  outlinks        Int      @default(0)
  externalLinks   Int      @default(0) @map("external_links")
  schemaTypes     String[] @default([]) @map("schema_types")
  lang            String?
  /// `[{ lang, href }]`
  hreflang        Json     @default("[]")
  inSitemap       Boolean  @default(false) @map("in_sitemap")
  /// Citability score v1 (0–100) of indexable pages.
  citabilityScore Int?     @map("citability_score")
  /// `{ version, factors: { <factor>: { value, data } } }`; see docs/geo-aeo.md.
  citability      Json?

  run    AuditRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  issues AuditIssue[]

  @@unique([runId, url])
  @@map("audit_page")
}

/// An internal link between crawled pages.
model AuditLink {
  id         String  @id @default(uuid(7)) @db.Uuid
  runId      String  @map("run_id") @db.Uuid
  fromPageId String  @map("from_page_id") @db.Uuid
  toUrl      String  @map("to_url")
  anchor     String?
  nofollow   Boolean @default(false)

  run AuditRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, toUrl])
  @@index([fromPageId])
  @@map("audit_link")
}

/// A problem found by an audit rule. `code` refers to the issue catalog in packages/core.
model AuditIssue {
  id       String        @id @default(uuid(7)) @db.Uuid
  runId    String        @map("run_id") @db.Uuid
  /// Null for site-wide issues, e.g. a missing sitemap.
  pageId   String?       @map("page_id") @db.Uuid
  code     String
  severity IssueSeverity
  data     Json          @default("{}")

  run  AuditRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  page AuditPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([runId, code])
  @@index([pageId])
  @@map("audit_issue")
}

// ── AI visibility (GEO/AEO) ─────────────────────────────────────────────────────────

/// Where an AI answer comes from. See docs/geo-aeo.md for the method behind each one.
enum AiPlatform {
  /// ChatGPT as users see it (DataForSEO LLM Scraper).
  CHATGPT
  /// Gemini as users see it (DataForSEO LLM Scraper).
  GEMINI
  /// Perplexity Sonar models (DataForSEO LLM Responses, live).
  PERPLEXITY
  /// Claude with web search (DataForSEO LLM Responses, live).
  CLAUDE
  /// Google AI Mode (DataForSEO SERP API).
  GOOGLE_AI_MODE
  /// The AI Overview on Google's results page for the prompt (DataForSEO SERP API).
  GOOGLE_AI_OVERVIEW

  @@map("ai_platform")
}

enum AiFrequency {
  DAILY
  WEEKLY

  @@map("ai_frequency")
}

enum AiRunStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("ai_run_status")
}

/// A question the project asks AI platforms on a schedule.
model Prompt {
  id           String   @id @default(uuid(7)) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  /// Up to 500 characters, single spaces.
  text         String
  locationCode Int      @map("location_code")
  languageCode String   @map("language_code")
  tags         String[] @default([])
  /// Paused prompts keep their history but are not asked again.
  active       Boolean  @default(true)
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs      AiRun[]

  @@unique([projectId, text, locationCode, languageCode])
  @@index([workspaceId, projectId])
  @@map("prompt")
}

/// How a project's prompts are asked: platforms, schedule, samples and models.
model ProjectAiSettings {
  projectId   String       @id @map("project_id") @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  platforms   AiPlatform[]
  frequency   AiFrequency  @default(WEEKLY)
  /// Answers collected per prompt, platform and period (answers vary between runs).
  samples     Int          @default(1)
  /// Model per LLM Responses platform, e.g. `{ "CLAUDE": "claude-haiku-4-5" }`.
  models      Json         @default("{}")
  /// Classify the tone of each brand mention (costs LLM tokens).
  sentiment   Boolean      @default(false)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("project_ai_settings")
}

/// One answer of one platform to one prompt. Created as PENDING when requested and
/// completed with the answer, its citations and the detected brand mentions.
model AiRun {
  id              String      @id @default(uuid(7)) @db.Uuid
  workspaceId     String      @map("workspace_id") @db.Uuid
  projectId       String      @map("project_id") @db.Uuid
  promptId        String      @map("prompt_id") @db.Uuid
  platform        AiPlatform
  /// `llm_scraper`, `llm_responses`, `google_ai_mode` or `google_ai_overview`.
  method          String
  /// Model requested or reported by the platform.
  model           String?
  sampleIndex     Int         @default(0) @map("sample_index")
  /// Day of the run in the project's time zone (the period the answer belongs to).
  runOn           DateTime    @map("run_on") @db.Date
  status          AiRunStatus @default(PENDING)
  /// DataForSEO task ID while the answer is being collected.
  providerTaskId  String?     @map("provider_task_id")
  postedAt        DateTime?   @map("posted_at") @db.Timestamptz(3)
  completedAt     DateTime?   @map("completed_at") @db.Timestamptz(3)
  /// The answer text (Markdown when the platform returns it); `null` without an answer.
  answer          String?
  /// SHA-256 of the answer, to compare answers without loading them.
  answerHash      String?     @map("answer_hash")
  webSearch       Boolean?    @map("web_search")
  fanOutQueries   String[]    @default([]) @map("fan_out_queries")
  /// Evidence kept with the answer: web results looked at, brands the platform marked,
  /// token usage and the check URL.
  details         Json        @default("{}")
  /// Version of the detection rules that produced the mentions and citations.
  detectorVersion Int         @default(1) @map("detector_version")
  costUsd         Decimal     @default(0) @map("cost_usd") @db.Decimal(12, 6)
  error           String?
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prompt    Prompt       @relation(fields: [promptId], references: [id], onDelete: Cascade)
  mentions  AiMention[]
  citations AiCitation[]

  @@unique([promptId, platform, runOn, sampleIndex])
  @@index([projectId, runOn])
  @@index([status, postedAt])
  @@index([providerTaskId])
  @@map("ai_run")
}

/// A tracked brand (own or competitor) mentioned in an answer.
model AiMention {
  runId               String  @map("run_id") @db.Uuid
  entityId            String  @map("entity_id") @db.Uuid
  /// Order of the brand's first mention among all tracked brands in the answer; 1 = first.
  firstRank           Int     @map("first_rank")
  /// Character offset of the first mention in the answer.
  firstOffset         Int     @map("first_offset")
  mentionCount        Int     @map("mention_count")
  /// `positive`, `neutral` or `negative` when sentiment is enabled.
  sentiment           String?
  sentimentConfidence Float?  @map("sentiment_confidence")
  classifierVersion   Int?    @map("classifier_version")

  run    AiRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  entity BrandEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([runId, entityId])
  @@index([entityId])
  @@map("ai_mention")
}

/// A source an answer cites, in the answer's order.
model AiCitation {
  runId    String  @map("run_id") @db.Uuid
  /// 1 = listed first.
  rank     Int
  url      String?
  /// Host of the URL, e.g. `blog.example.com`.
  host     String?
  /// Registrable domain (Public Suffix List), e.g. `example.com`.
  domain   String
  title    String?
  /// The tracked brand whose domains the source belongs to.
  entityId String? @map("entity_id") @db.Uuid
  /// The source as one of the project's known pages (normalized URL), when it matches one.
  pageUrl  String? @map("page_url")

  run    AiRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  entity BrandEntity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  @@id([runId, rank])
  @@index([domain])
  @@index([entityId])
  @@map("ai_citation")
}
