// SEO-GEO database schema. Conventions (docs/data-model.md):
// - tables and columns are snake_case in PostgreSQL, camelCase in Prisma;
// - primary keys are UUIDs (v7 when generated by the application);
// - timestamps are timestamptz;
// - every tenant-owned row carries workspace_id, and queries always filter by it.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ── Identity (managed by Better Auth; field names must match its schema) ──────────

model User {
  id               String   @id @default(uuid(7)) @db.Uuid
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  locale           String?
  twoFactorEnabled Boolean? @default(false) @map("two_factor_enabled")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      Session[]
  accounts      Account[]
  memberships   Member[]
  invitations   Invitation[]
  twoFactors    TwoFactor[]
  notifications Notification[]

  @@map("user")
}

model Session {
  id                   String   @id @default(uuid(7)) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  token                String   @unique
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  /// Password hash for email + password accounts.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

/// Email verification and password reset tokens.
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

/// Shown in the product as a workspace.
model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  members             Member[]
  invitations         Invitation[]
  projects            Project[]
  brandEntities       BrandEntity[]
  providerCredentials ProviderCredential[]
  usageEntries        UsageEntry[]
  budget              Budget?
  tasks               Task[]
  auditLogs           AuditLog[]
  notifications       Notification[]

  @@map("organization")
}

/// Workspace membership. Roles: owner, admin, member, viewer.
model Member {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String   @default("member")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  inviterId      String   @map("inviter_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

/// Public API and MCP keys. `referenceId` is the owning user.
model Apikey {
  id                  String    @id @default(uuid(7)) @db.Uuid
  configId            String    @default("default") @map("config_id")
  name                String?
  start               String?
  referenceId         String    @map("reference_id") @db.Uuid
  prefix              String?
  /// Hash of the key; the key itself is shown once.
  key                 String
  refillInterval      Int?      @map("refill_interval")
  refillAmount        Int?      @map("refill_amount")
  lastRefillAt        DateTime? @map("last_refill_at") @db.Timestamptz(3)
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true) @map("rate_limit_enabled")
  rateLimitTimeWindow Int?      @default(86400000) @map("rate_limit_time_window")
  rateLimitMax        Int?      @default(10) @map("rate_limit_max")
  requestCount        Int?      @default(0) @map("request_count")
  remaining           Int?
  lastRequest         DateTime? @map("last_request") @db.Timestamptz(3)
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

// ── Projects ───────────────────────────────────────────────────────────────────

enum Device {
  DESKTOP
  MOBILE

  @@map("device")
}

model Project {
  id                  String    @id @default(uuid(7)) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  name                String
  slug                String
  /// Normalized hostname without `www.`, e.g. `example.com`.
  domain              String
  includeSubdomains   Boolean   @default(true) @map("include_subdomains")
  /// DataForSEO location code, e.g. 2792 for Turkey.
  defaultLocationCode Int       @map("default_location_code")
  defaultLanguageCode String    @map("default_language_code")
  defaultDevice       Device    @default(DESKTOP) @map("default_device")
  timezone            String    @default("UTC")
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace     Organization  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandEntities BrandEntity[]
  usageEntries  UsageEntry[]
  tasks         Task[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, createdAt])
  @@map("project")
}

enum BrandKind {
  OWN
  COMPETITOR

  @@map("brand_kind")
}

/// The project's own brand and its competitors; one OWN entity per project (enforced by the service).
model BrandEntity {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  kind        BrandKind
  name        String
  /// Registrable domains that count as this brand.
  domains     String[]
  /// Other names the brand is mentioned by, e.g. product names.
  aliases     String[]
  /// Categorical chart slot (1–8); the own brand is always 1.
  colorSlot   Int       @map("color_slot")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId])
  @@map("brand_entity")
}

// ── Workspace-level entities ───────────────────────────────────────────────────────

enum Provider {
  DATAFORSEO
  OPENAI
  ANTHROPIC
  GOOGLE_AI
  OPENROUTER
  PERPLEXITY

  @@map("provider")
}

enum CredentialStatus {
  UNVERIFIED
  VALID
  INVALID

  @@map("credential_status")
}

/// A workspace's own provider key. The secret is AES-256-GCM encrypted and never returned.
model ProviderCredential {
  id              String           @id @default(uuid(7)) @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  provider        Provider
  label           String
  encryptedSecret Bytes            @map("encrypted_secret")
  keyVersion      Int              @map("key_version")
  status          CredentialStatus @default(UNVERIFIED)
  /// Non-secret details from the last verification, e.g. the DataForSEO login and balance.
  details         Json             @default("{}")
  lastError       String?          @map("last_error")
  lastVerifiedAt  DateTime?        @map("last_verified_at") @db.Timestamptz(3)
  createdBy       String?          @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@map("provider_credential")
}

enum BilledTo {
  /// Paid with the workspace's own provider key.
  WORKSPACE
  /// Paid with platform keys (cloud edition), charged as credits.
  PLATFORM

  @@map("billed_to")
}

/// Append-only ledger of provider costs.
model UsageEntry {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  taskId      String?  @map("task_id") @db.Uuid
  provider    Provider
  operation   String
  units       Int      @default(1)
  costUsd     Decimal  @map("cost_usd") @db.Decimal(12, 6)
  billedTo    BilledTo @default(WORKSPACE) @map("billed_to")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("usage_entry")
}

/// Monthly spending limit across providers. Checked before paid work is queued.
model Budget {
  workspaceId     String   @id @map("workspace_id") @db.Uuid
  monthlyLimitUsd Decimal  @map("monthly_limit_usd") @db.Decimal(12, 2)
  /// Block paid work once the limit is reached; otherwise only notify.
  hardStop        Boolean  @default(true) @map("hard_stop")
  /// Percentages of the limit that trigger a notification.
  alertThresholds Int[]    @default([50, 80, 100]) @map("alert_thresholds")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("budget")
}

enum TaskStatus {
  queued
  running
  succeeded
  failed
  canceled

  @@map("task_status")
}

/// A user-visible background operation.
model Task {
  id               String     @id @default(uuid(7)) @db.Uuid
  workspaceId      String     @map("workspace_id") @db.Uuid
  projectId        String?    @map("project_id") @db.Uuid
  type             String
  status           TaskStatus @default(queued)
  /// 0–100.
  progress         Int        @default(0)
  input            Json       @default("{}")
  result           Json?
  error            Json?
  estimatedCostUsd Decimal?   @map("estimated_cost_usd") @db.Decimal(12, 6)
  actualCostUsd    Decimal    @default(0) @map("actual_cost_usd") @db.Decimal(12, 6)
  idempotencyKey   String?    @map("idempotency_key")
  createdBy        String?    @map("created_by") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt        DateTime?  @map("started_at") @db.Timestamptz(3)
  finishedAt       DateTime?  @map("finished_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  usageEntries UsageEntry[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, createdAt])
  @@map("task")
}

/// Security-relevant actions.
model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorApiKeyId String?  @map("actor_api_key_id") @db.Uuid
  action        String
  targetType    String?  @map("target_type")
  targetId      String?  @map("target_id")
  metadata      Json     @default("{}")
  ip            String?
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("audit_log")
}

model Notification {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        String
  /// English fallback; clients render localized text from `type` and `data`.
  title       String
  body        String?
  /// Values for the localized message, e.g. `{ "percent": 80 }`.
  data        Json      @default("{}")
  link        String?
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([workspaceId, createdAt])
  @@map("notification")
}
