# Copy to .env and adjust. Values below are for local development.

# ── Runtime ─────────────────────────────────────────────────────────────
NODE_ENV=development
# api | worker
APP_MODE=api
# selfhost | cloud
DEPLOYMENT_MODE=selfhost
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log

# ── URLs ────────────────────────────────────────────────────────────────
# Public URL of the web app (used for links in emails and OAuth redirects)
WEB_URL=http://localhost:3000
# Where the web app forwards /api/* requests
API_URL=http://localhost:4000
# Port the api listens on
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────
# Application connection. On Supabase use the transaction pooler (port 6543).
DATABASE_URL=postgresql://seogeo:seogeo@localhost:5432/seogeo
# Migrations. On Supabase use the direct or session connection (port 5432).
DIRECT_URL=postgresql://seogeo:seogeo@localhost:5432/seogeo

# ── Security ──────────────────────────────────────────────────────────────
# `pnpm env:setup` fills both. Otherwise generate each with: openssl rand -base64 32
# Signs sessions and tokens.
AUTH_SECRET=
# Encrypts provider credentials (AES-256-GCM). Changing it makes stored keys unreadable.
ENCRYPTION_KEY=
# Which proxies may set X-Forwarded-For (Express "trust proxy"). The web app is one.
TRUST_PROXY=loopback, linklocal, uniquelocal
# Ports the crawler may request on user-supplied sites (internal addresses are always refused).
OUTBOUND_ALLOWED_PORTS=80,443

# ── Email ─────────────────────────────────────────────────────────────────
# Without SMTP, email verification is skipped; in development emails are printed to the
# api console instead. The cloud edition requires SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SEO-GEO <noreply@example.com>"

# ── Cloud edition only ──────────────────────────────────────────────────
# Platform-level provider keys. Self-hosted workspaces enter their own keys in settings.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Stripe billing. Use a restricted key with Checkout Sessions and Customer Portal access.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# true: Stripe Managed Payments (Stripe is the merchant of record and handles sales tax/VAT)
STRIPE_MANAGED_PAYMENTS=true
